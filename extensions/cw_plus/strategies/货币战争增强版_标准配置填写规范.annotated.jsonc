// 货币战争增强版：标准攻略配置填写规范（带注释）
// 适用于 CurrencyWarsPlus 扩展；字段约束以当前发布代码为准。
// 界面名称为“货币战争优化版”；本文依据该外置扩展的现行代码及配置整理。
//
// 【文件用途与保存方法】
// 本文件是 JSONC 填写参考。下面唯一的根对象去掉全部 // 注释后是完整 JSON 示例。
// 示例采用姬子七级稳搜与人口优先规则，数值用于演示，不是所有阵容的默认值。
// 本文件不会出现在攻略列表；使用时复制、改名、删除注释，保存为 my_strategy.json。
// 不能只把 .jsonc 改名为 .json：运行时使用严格 JSON，不支持任何注释或尾随逗号。
// 配置目录：extensions/cw_plus/strategies/
// 在扩展配置中点击“扫描攻略文件夹”，按 title 选择新攻略，再启动本扩展。
// 扫描只检查 JSON 能否读取，不等于已通过运行时字段校验；不要在运行中途修改攻略。
// 裸文件名从本扩展 strategies 目录读取；带目录的路径按指定位置读取。
//
// 【统一书写规范】
// 1. 使用 UTF-8 无 BOM，文件根节点为对象 {}；攻略扫描只收录不超过 1 MiB 的 .json。
// 2. 键名和字符串用英文双引号，数字不加引号，布尔值为 true/false，空值为 null。
// 3. 字段名大小写须一致；不得重复键。除注明可用 null 的位置外，不用 null 代替省略。
// 4. 不向正式 JSON 添加 _comment 等自创字段；部分对象会拒绝未知字段，部分会忽略它们。
// 5. 角色使用 ../characters.py 中的规范名。开拓者统一写“开拓者”，不填玩家昵称。
//    “姬子·启行”与“姬子”、“银狼LV.999”与“银狼”、“火花”与“花火”分别是不同角色。
// 6. 所有 x-y 回合字段均为字符串，两段各一位 1–9，例如 "1-4"；不写 "01-04"、"3-10"。
// 7. 人口容量(min_capacity)、商店等级(*_level)、真实战斗数(from_battles)、关卡(x-y)分别填写。
//
// 【建议填写顺序】
// 展示信息 → 采购名单及主 C → 阶段阵容/职责 → 经济 → 事件/装备 → 开局及奖励回合。
// 换角色时同步检查每一个角色引用；改羁绊时同时检查 traits、preserve_traits、upgrade_gate。
{
  // 展示信息：均按字符串填写；title 是列表标题，保存的选择值实际是文件名。
  // 这些信息不决定购买、升级、布阵。保留这四项便于完整记录攻略来源。
  "title": "【填写模板】货币战争增强版标准配置（姬子示例）",
  "description": "完整格式示例：七级先确认姬子·启行上场，二星后允许继续升级；请按自己的阵容调整。",
  "author": "",
  "uploader": "",
  // 游戏内攻略分享码，填真实完整代码；不导入则填 ""。它不代替下面的本地策略。
  "share_code": "",

  // 【主 C 与首次搜索】
  // main_c 可省略/null 关闭；启用须填根 on_field 或 off_field 中已定义的合法角色。
  // main_c_search_level：正整数，默认5。达到此商店等级且尚未确认主 C 首次上场时，
  // 暂停常规买经验，先搜到并部署主 C。持有在备战席不算首次上场。
  // 尚未达到搜索等级时，当前页的需求卡仍会购买；不会仅为首次主 C 提前主动搜牌。
  // 首次上场不要求先达到采购目标星级；后续星级门槛使用 formation.upgrade_gate。
  "main_c": "姬子·启行",
  "main_c_search_level": 7,
  // 非负整数，默认0。首次搜索需求购牌后保留此余额，不使用常规经济阶段的保留金。
  // 首次搜索不叠加 economy.purchase_reserve_gold，但可使用下面独立的首搜购牌余量。
  // 首次上场确认后恢复常规经济规则。3-7 强制运营和 all_in 冲级可覆盖此限制。
  "main_c_search_min_coins": 10,
  // 可选根字段 main_c_search_purchase_reserve_gold：非负整数，默认0。
  // 它为首次搜索另外预留购牌金；付费刷新后须保留“首搜底线＋该余量”，
  // 需求购牌仍可使用余量，只须保留 main_c_search_min_coins。不能与常规P重复相加。
  // 例如底线10、余量5时，付费刷新后至少留15，需求购牌后至少留10。
  // 按需启用下一行；此注释示例省略该字段，因此当前余量为默认0：
  // "main_c_search_purchase_reserve_gold": 5,

  // 【旧经济兼容字段】
  // 均为非负整数；省略默认 min_coins=40、min_level=7、mid_level=7。
  // economy.enabled=true 时这三项不决定新经济运营，但填写的类型仍须合法。
  // 关闭新经济时：min_coins 为旧普通刷新门槛，min_level 为旧补级目标，
  // mid_level 为旧条件式升级上限；min_coins 不是所有支出后的统一余额底线。
  "min_coins": 10,
  "min_level": 7,
  "mid_level": 9,

  // ssyb：采购星级与实际副本数分别填写、分别核验。
  // 【采购目标】根级为对象："角色名": 目标星级，只使用整数1、2、3。
  // 不是买入张数。启用 formation 后不能沿用旧4/9张写法；两星按3张、三星按9张累计。
  // 这里涵盖正式与过渡采购目标，不局限于当前阶段。顺序参与基础优先级。
  // 根名单允许多于前台4人；实际每阶段前台人数见 formation.stages。
  // 同名角色可同时写入根前后台以声明两区许可，目标取较高星级，不表示买两队。
  // 若无此需要，每名角色只列一次；有意跨区兜底时须同时核对角色原生可用区域与职责。
  // 阶段明确的站位可与根名单不同，根区域还参与首次主 C 确认及部分冲突处理。
  "on_field": {
    "姬子·启行": 3,
    "瓦尔特": 1,
    "开拓者": 2,
    "花火": 2,
    "星期日": 1,
    "丹恒·饮月": 1
  },
  "off_field": {
    "三月七": 2,
    "刻律德菈": 2,
    "符玄": 2,
    "千冶·刃": 2,
    "缇宝": 2
  },

  // 【特殊事件】可省略或 {}；键和值都必须是字符串。
  // 当前支持关键词的事件：头号玩家、盛会之星、命运卜者、领航员、命运圣杯。
  // 新增其他键不会新增事件处理能力。
  // > 分隔优先级组，从左到右优先；同组空格分隔“任一匹配”词，组内按界面选项顺序。
  // 例：先找包含“护盾”或“三月七”的选项，没有再找“能量”或“星期日”，再找最后一组。
  // 可用全角 ＞，建议统一用英文 >；不能出现空组，如 "> 护盾"、"护盾 >"、"护盾 >> 能量"。
  // 非空关键词均未匹配时，复核后停止本次选择；未配置/空字符串沿用末项默认选择。
  "special_events": {
    "领航员": "护盾 三月七 > 能量 星期日 > 战技点 丹恒·饮月"
  },

  // 【分阶段阵容】省略/null 沿用旧布阵；一旦写对象，stages 必须是非空数组。
  // formation 不提供 enabled 开关；不要用 {"enabled": false} 代替删除或 null。
  "formation": {
    // roles 只是“谁能提供职责”的声明，须配合 role_requirements 才提出需求。
    // 职责名自定义，前后引用完全一致；提供者必须为合法、可操作角色。
    // area 可为 "on_field"、"off_field" 或两者数组；省略表示两区均允许。
    // min_stars 为1–3整数，默认1；必须在允许区域可靠上场且星级达标才算满足职责。
    // 职责缺口可驱动采购，并与根采购目标取较高星级；仅在备战席不算覆盖职责。
    "roles": {
      "march_shield": [
        {"name": "三月七", "area": "off_field", "min_stars": 1}
      ]
    },
    "role_requirements": {
      "march_shield": {
        // minimum：不同角色覆盖数，1–10整数，默认1，不能超过候选数或区域容量。
        "minimum": 1,
        // candidates 正式候选；interim_candidates 过渡候选，两列表不得重叠，
        // 均须属于上面同一职责的提供者。职责候选可不在根名单，由缺口驱动采购。
        // 省略 candidates 时默认该职责中除过渡候选以外的提供者；过渡列表默认空。
        "candidates": ["三月七"],
        "interim_candidates": [],
        // 默认 warn_continue：缺牌/已确认无合法部署方案时允许记录缺口继续；
        // 未知状态、关键待上场角色和未确认移动仍可阻止出战。
        // block：职责未满足就阻止出战。仅支持这两个值，不按文本“生存”自动判断能力。
        "on_missing": "warn_continue"
      }
    },
    // traits 是手工羁绊表；程序不查询游戏羁绊。成员、名称、前后台真实效果需自己核对。
    // 计数按可靠上场的不同角色，前后台都统计，同名副本不重复统计。
    "traits": {
      "姬子·启行": ["列车同行"],
      "丹恒·饮月": ["列车同行"],
      "星期日": ["列车同行"],
      "三月七": ["列车同行"],
      "开拓者": ["列车同行"],
      "瓦尔特": ["列车同行"],
      "花火": ["量子同频"],
      "符玄": ["量子同频"],
      "缇宝": ["量子同频"]
    },
    // 只防止已达到的羁绊跌破阈值，不会主动要求凑齐；值为1–99整数。
    // 键须在 traits 中有成员定义。不需要则 {} 或省略；勿保护与后续换人冲突的组合。
    "preserve_traits": {"列车同行": 4},
    // 可省略/null。from_level 必填，1–99整数：当前等级达到此值后限制常规升级。
    // fielded/traits/prices 均可省略或 {}；三类同时满足才放行。
    // fielded 的值为已上场所需星级1–3；此例二星允许升级，但根采购目标仍追三星。
    // 可选 traits: {"列车同行": 4} 要求在场羁绊人数；阈值1–99。
    // 可选 prices: {"姬子·启行": 3} 要求可靠观测费用至少3；它不是最高购入价格。
    // prices 阈值1–99，只能填已知角色；它不赋予升费能力，也不自动提高采购星级。
    "upgrade_gate": {
      "from_level": 7,
      "fielded": {"姬子·启行": 2}
    },
    // stages 按顺序判断，遇到第一个未满足条件就停止，不跳过前一阶段进入后一阶段。
    // name 非空且唯一；min_capacity 解析范围0–99，实际按可实现的人口填写。
    // 首阶段必须为0且没有角色前置条件；后续门槛不能降低，可以相同。
    // 门槛是普通角色可用人口容量：总容量扣除已确认/仍需预留的支援NPC占位。
    // 因此界面“9人口”且有1个占人口NPC时，不等于满足 min_capacity=9。
    // 下列前后台为名字数组，每阶段前台1–4人，两区不得重复；后台按实际可用槽位，
    // 物理最多6槽，支援/锁定位会缩减普通槽位。不能用增大数组来增加真实人口。
    // 角色须在根采购名单或 roles 提供者中；priority 只能来自本阶段前后台。
    // priority 可省略/只列部分，余项按前台再后台补齐；表示部署优先级，不是固定格坐标。
    "stages": [
      {
        "name": "四列车起步",
        "min_capacity": 0,
        "on_field": ["姬子·启行", "丹恒·饮月", "星期日"],
        "off_field": ["三月七"],
        "priority": ["姬子·启行", "三月七", "丹恒·饮月", "星期日"]
      },
      {
        "name": "五人口补千冶刃",
        "min_capacity": 5,
        "on_field": ["姬子·启行", "丹恒·饮月", "星期日"],
        "off_field": ["三月七", "千冶·刃"],
        "priority": ["姬子·启行", "三月七", "丹恒·饮月", "星期日", "千冶·刃"]
      },
      {
        "name": "六人口补刻律",
        "min_capacity": 6,
        "on_field": ["姬子·启行", "丹恒·饮月", "星期日"],
        "off_field": ["三月七", "千冶·刃", "刻律德菈"],
        "priority": ["姬子·启行", "三月七", "丹恒·饮月", "星期日", "千冶·刃", "刻律德菈"]
      },
      {
        "name": "七人口攻略中期阵容",
        "min_capacity": 7,
        "on_field": ["姬子·启行", "开拓者", "花火", "星期日"],
        "off_field": ["千冶·刃", "三月七", "刻律德菈"],
        "priority": ["姬子·启行", "三月七", "开拓者", "星期日", "花火", "千冶·刃", "刻律德菈"]
      },
      {
        "name": "八人口补符玄",
        "min_capacity": 8,
        "on_field": ["姬子·启行", "开拓者", "花火", "星期日"],
        "off_field": ["三月七", "刻律德菈", "符玄", "千冶·刃"],
        "priority": ["姬子·启行", "三月七", "开拓者", "星期日", "花火", "千冶·刃", "刻律德菈", "符玄"]
      },
      {
        "name": "九人口补缇宝等瓦尔特",
        "min_capacity": 9,
        "on_field": ["姬子·启行", "开拓者", "花火", "星期日"],
        "off_field": ["三月七", "刻律德菈", "符玄", "千冶·刃", "缇宝"],
        "priority": ["姬子·启行", "三月七", "开拓者", "星期日", "花火", "千冶·刃", "刻律德菈", "符玄", "缇宝"]
      },
      {
        "name": "九人口瓦尔特换星期日",
        "min_capacity": 9,
        // requires_available：可靠持有即可，含备战席；不是已上场要求。
        // 可选 requires_fielded: ["姬子·启行"] 要求已在前台或后台。
        // 可选 requires_stars: {"姬子·启行": 2} 要求可靠持有至少两星，备战席也算。
        // 三类前置条件同时满足才进阶段，不会自动提高根采购目标；角色均须已定义。
        // 新阶段才准备上场的角色宜用 requires_available，避免先上场才能进阶段的循环。
        // 可选 role_requirements: {"march_shield": {"on_missing": "block"}}
        // 表示本阶段覆盖全局同名职责；未写子项继承全局，不继承前一阶段。
        "requires_available": ["开拓者", "瓦尔特"],
        "on_field": ["姬子·启行", "瓦尔特", "开拓者", "花火"],
        "off_field": ["三月七", "刻律德菈", "符玄", "千冶·刃", "缇宝"],
        "priority": ["姬子·启行", "三月七", "开拓者", "瓦尔特", "花火", "千冶·刃", "刻律德菈", "符玄", "缇宝"]
      }
    ]
  },

  // 【开局保护】可省略/null；对象内两项均可单独省略，省略项不受回合限制。
  // 从指定准备关卡起允许动作，包含本关；回合未知时仍保持该动作禁用。
  // 禁刷新仍购买自然商店需求牌；禁卖仍允许符合条件的部署；不额外禁止买经验。
  "opening_policy": {
    "sell_from_round": "1-4",
    "refresh_from_round": "1-4"
  },

  // 【经济规则】省略/null 或 enabled=false 使用旧经济；enabled 省略也为 false。
  // 启用后 stages 非空；不要混入 roll_from_level、overflow_gold 等未支持字段。
  "economy": {
    "enabled": true,
    // 记当前阶段 reserve_gold 为R，此处 purchase_reserve_gold 为P，P默认0，非负整数。
    // 普通付费买需求卡：买后余额>=R；付费刷新/买经验：支出后余额>=R+P。
    // 本例R=0、P=10：日常刷新/买经验保留10，买需求牌可以使用这10；不是统一保留10。
    // 首次主 C 搜索改用 main_c_search_min_coins，不叠加这里的常规P；
    // 如需首搜额外留购牌金，使用根字段 main_c_search_purchase_reserve_gold。
    // all_in 生效时常规R/P均为0，3-7强制终局运营也覆盖日常首搜储备。
    // 可靠确认免费动作时不会继续降低余额，可不受金币底线阻挡，其他条件仍有效。
    "purchase_reserve_gold": 10,
    // from_battles：已确认结束的真实战斗数（或可靠累计下界），不是循环次数或关卡号。
    // 首行必须0，后续严格递增；target_level 不得降低；各行 reserve_gold 可升可降。
    // from_battles/reserve_gold：非负整数；target_level：1–20整数，须填实际可达目标。
    // 最后一行目标不得低于已配置主 C 的 search_level。本例常规最终目标9级，
    // 仍受“7级先主 C 上场、二星再升级”的门槛约束，不会因填9就立即无条件冲9。
    // upgrade_gold：null/省略表示无金币提前触发；非负整数表示金币达到即提前进入本行。
    // 真实战斗数与两次稳定金币读数满足其一即可推进，选符合条件的最高行，同局不倒退。
    "stages": [
      {"from_battles": 0, "target_level": 9, "reserve_gold": 0, "upgrade_gold": null}
    ]
    // 如需分段运营，可把 stages 整段替换为以下示例（不直接叠加两份同名字段）：
    // [
    //   {"from_battles": 0,  "target_level": 7, "reserve_gold": 0,  "upgrade_gold": null},
    //   {"from_battles": 6,  "target_level": 8, "reserve_gold": 20, "upgrade_gold": 60},
    //   {"from_battles": 12, "target_level": 9, "reserve_gold": 20, "upgrade_gold": 100}
    // ]
    // 第二行是“完成6战或确认60金币就进8级阶段”；60不是每次升级后的保留金。
    // 续跑旧存档、历史战斗数未知时，可用已确认等级恢复经济阶段下界，不反推战斗场数。
    //
    // 可选 all_in_round：在 stages 后补逗号并加入 "all_in_round": "3-5"。
    // 不用则省略，不能写 null/false。到指定关卡及以后，在读数可靠且足够完成到最终
    // 目标等级的升级时，先冲最终目标；达到目标后零保留买需求牌/刷新。
    // 此冲级分支会覆盖首次主 C 与 upgrade_gate 限制，且可扩大日常购物次数额度。
    // 金币不足完成整段升级或信息未知时不启用，沿用常规经济；不保证必须花尽金币。
    // 奖励速战回合只走自然页采购，不执行上述冲级。3-7另有强制规则，见文末。
  },

  // 【装备】省略/null 恢复旧装备行为，并非禁用装备。
  // 对象内 priority_characters、others_from_round 必填；interval_battles 默认2。
  // 无装备名称/配方字段：当前按游戏推荐分配，不能配置双风暴潮、三鞋等逐件配方。
  "equipment": {
    // 非空、无重复的合法可操作角色名数组；顺序为合格已上场角色的检查优先顺序。
    // 不自动买人或上人，备战席角色不在装备分配范围。
    "priority_characters": ["姬子·启行", "三月七", "花火", "刻律德菈", "千冶·刃"],
    // 此关卡前仅处理优先名单，达到此关卡后才开放其他已上场角色；未知回合仍只优先。
    "others_from_round": "3-1",
    // 正整数，每完成几场真实战斗到期一次；首次确认开放其他角色也可触发一次检查。
    // 因此它不是“严格只在第2/4/6战处理”。奖励速战期间会跳过该轮装备处理。
    "interval_battles": 2
  },

  // 【奖励回合速战】新增可选顶层字段，省略/null/[] 为普通准备流程。
  // 无重复的 x-y 字符串数组，只匹配列出的准备关卡，不表示该回合以后全部速战。
  // 当前常用奖励回合如下；仅在无待确认移动/布阵且关卡可靠时启用。
  // 启用后只买当前自然商店的需求卡，遵守采购保留金与次数预算；不刷新、不买经验，
  // 跳过该轮常规水晶收集、整队扫描/布阵/出售/装备，留待普通准备流程处理。
  // 不要把需要换阵/补装备的普通战斗随意加入；"3-7" 即使填入也不启用速战。
  "reward_fast_rounds": ["1-8", "2-6", "3-6"],

  // 【准备预算】可整块省略/null，或只覆盖需要调整的字段；以下全为默认值。
  // seconds/actions/total_seconds/field_refresh_seconds：1–600整数。
  // recoveries/move_retries：0–600整数，0表示不给相应额外恢复/重试额度。
  "preparation_budget": {
    "seconds": 120,                 // 同一准备期布阵共用时限，不得超过 total_seconds。
    "actions": 20,                  // 布阵移动尝试数，不是买牌数。
    "recoveries": 2,                // 布阵恢复额度。
    "move_retries": 1,              // 同一移动的额外重试次数。
    "total_seconds": 300,           // 准备流程预算；购物耗时会加回，不是绝对墙钟总时长。
    "field_refresh_seconds": 60     // 场地角色记录的时效检查点（秒），不是装备间隔。
    // confirmation_seconds 默认30，1–600且不得超过 total_seconds；省略时可自动缩小。
    // 当前此字段只有解析校验，尚未接入动作确认时限；不要靠它调节确认超时。
  },
  // 【购物预算】可省略或 {}，不支持 null；只覆盖写出的字段。
  // actions 默认60、seconds 默认90，其余默认60；actions/seconds 为1–300，其他0–300。
  // 次数按同一准备期累计，关闭/重开商店不重置；refreshes 不是整局总次数。
  // 日常分项为0禁用对应支出；actions 同时约束购买尝试、刷新、买经验之和。
  // all_in 可扩大各动作额度（包括原来为0的项）；3-7独立覆盖日常预算，见文末。
  "shopping_budget": {
    "actions": 60,
    "seconds": 90,                  // 兼容字段：当前正常购物不按它限制总秒数。
    "purchases": 60,
    "refreshes": 6,                 // 仅本示例为6；随附两份正式攻略为12，程序默认60。
    "experiences": 60
  }
}

// 【可选进阶字段：按需加到 formation 对象内】
// 下列是结构示例，不属于上面默认示例的生效内容。启用时先核对与各阶段目标的关系。
//
// A. assignment_groups：在指定区域择优使用一个席位，组名自定义。
// "assignment_groups": {
//   "secondary_dps": {
//     "area": "on_field",             // 必填：on_field 或 off_field。
//     "count": 1,                     // 默认1；当前仅支持整数1。
//     "candidates": [                 // 非空；须在根采购名单；同角色不能跨多个组。
//       {"name": "瓦尔特", "rank": 200, "min_stars": 1},
//       {"name": "星期日", "rank": 100, "min_stars": 1}
//     ],
//     "replace_from": ["星期日", "瓦尔特"],
//     "star_policy": "prefer_not_lower",
//     "keep_incumbent_on_tie": true,
//     "on_unavailable": "keep_current"
//   }
// }
// rank 默认0，范围0–100000，越大越优先；min_stars 默认1，范围1–3。
// 候选先比较可靠星级，再比较rank；更高rank不会让一星角色换掉两星现任。
// 同条件或证据不足保留现任。后三个字段仅支持示例值，省略也采用这些值。
// replace_from 默认所有候选，必须为本组候选的非空子集；至少一个阶段存在该组席位，
// 每个阶段在该组区域内最多列出其中一名。候选可在别的区域另有用途，不是全局互斥。
// 席位 min_stars 只是入选条件，不自动提高根采购目标。
//
// B. position_rules：条件满足后把当前阶段已有目标移到另一前后台区域，不新增采购。
// "position_rules": [
//   {"name": "花火", "area": "off_field", "min_capacity": 9,
//    "requires_assignment": {"secondary_dps": "瓦尔特"}}
// ]
// 名字必须在根名单、同角色只一条、不能同时是席位组候选；area 必填为前台或后台。
// min_capacity 默认0、范围0–10，按普通角色容量判断；迁移后也须有真实可用槽位。
// requires_assignment 省略/{} 则不依赖席位；多组条件必须全部满足。
// 这个带条件的示例依赖上面的 secondary_dps；没定义组就不要引用它。
//
// C. protect_until_fielded：受保护角色到接班角色的映射，可省略/{}。
// "protect_until_fielded": {"丹恒·饮月": "开拓者"}
// 接班者已可靠上场才解除保护；不能自指、重复别名或形成循环。
// 它不自动购买接班者。需保证其采购/上场路径可达，不能指望未执行的一换一提前解除保护。
//
// 【其他兼容/低频字段：按需加到根对象内】
// equipment_interval_battles：正整数；仅需装备间隔而不需角色/关卡筛选时可以单独用。
// 若已写 equipment.interval_battles，不建议重复；两处数值不同会报错。
// health_roi：可省略/null；[x1,y1,x2,y2]，四个0–1数字，须 x1<x2 且 y1<y2。
// 这是自定义血量OCR区域，不是“按血量改变刷新次数”的策略。没有校准数据就省略。
//
// 【3-7 强制终局运营：不能靠攻略开关关闭】
// 当前代码在可靠确认准备关卡恰为3-7时，优先执行强制消费，覆盖常规保留金、
// 主 C 首次搜索升级限制、upgrade_gate、经济目标等级、开局刷新限制与日常购物额度。
// 每次判断是否有钱完成“下一整级”；够则升级并复核，不够/已满级则零保留买需求牌和搜牌。
// 它不是简单冲到 economy 最后一行等级；不开 economy、不写 all_in_round 也生效。
// 免费与付费刷新输入合计最多80次，同一准备期恢复不重置；第80次刷新后仍处理当前页需求牌。
// 余额不足可执行动作、刷新达到上限或证据/界面未确认时会停止/恢复，不承诺余额必为0。
// 这不取消角色目标、合法布阵、羁绊/职责保护或动作确认要求。
//
// 【扩展窗口设置：与攻略 JSON 分开填写】
// 开拓者名称(username)：填游戏内昵称，必须非空；攻略里的角色名仍写“开拓者”。
// 攻略(strategy)：选择列表项，或输入完整JSON路径；裸文件名从本扩展 strategies 目录解析。
// 运行次数(runtimes)：1–99999整数，默认1；难度(difficulty)：0最低/1最高/2当前，默认0。
// 超频博弈(overclock)：布尔值，默认false；开关在扩展窗口设置，不放入本攻略根对象。
//
// Yukki：结构校验与实际阵容效果需要分别核对。
// 【提交前核对】
// - 去掉注释后能按严格JSON读取，没有重名键、尾逗号、字符串数字或错误布尔值。
// - 根采购目标、主 C、阶段、职责、席位、迁移、接班、羁绊、装备中的角色名和引用一致。
// - 阶段人口可达到；角色准入星级不高于可实现采购目标；进阶段与上场条件无循环依赖。
// - 保护的羁绊/职责不会与目标换人互相阻塞；需要的位置有实际可用槽位。
// - 区分常规购买底线R、刷新/经验底线R+P，以及首搜底线和首搜专用购牌余量，理解3-7强制覆盖。
// - 配置能加载只证明结构合法，不能证明阵容、游戏内效果或实战强度。
//
// 【核对来源：均相对于 extensions/cw_plus】
// ../currency_wars_plus.py：扩展窗口字段；paths.py、strategy_catalog.py：目录与扫描。
// CurrencyWars.py：load_strategy、主 C、事件优先级、购物/装备/速战与3-7实际执行分支。
// formation.py：validate_formation_config、阶段/席位/职责、普通人口与位置冲突规则。
// economy.py、policy.py、equipment_policy.py、preparation.py、reward_fast.py：解析与默认值。
// characters.py：规范角色名；strategies/himeko_nova_march_pilot_power_20261013.json：例子基础。
