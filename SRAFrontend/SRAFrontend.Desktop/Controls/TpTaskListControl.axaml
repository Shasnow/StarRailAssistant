<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
             xmlns:controls="clr-namespace:SRAFrontend.Desktop.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="SRAFrontend.Desktop.Controls.TpTaskListControl"
             x:DataType="viewModels:TaskPageViewModel"
             Width="560" Height="560">
    <Grid RowDefinitions="*, Auto">
        <ListBox Grid.Row="0" ItemsSource="{Binding TrailblazePowerConfig.TaskList}"
                 SelectedItem="{Binding SelectedTaskItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="*,*,*" ColumnDefinitions="Auto,*">
                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Content="{Binding Name, Converter={x:Static controls:LocalizedStringConverter.Instance}}" HorizontalAlignment="Center" />
                            <Label Grid.Row="1" Grid.Column="0"><x:Static Member="lang:ExtraResources.U0181" /></Label>
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding LevelName, Converter={x:Static controls:LocalizedStringConverter.Instance}}" />
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Content="{x:Static lang:ExtraResources.U0253}"
                                   IsVisible="{Binding AutoDetect}" />
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  RowDefinitions="*, *" ColumnDefinitions="Auto, *"
                                  IsVisible="{Binding !AutoDetect}">
                                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static lang:ExtraResources.U0250}" />
                                <Label Grid.Row="0" Grid.Column="1" Content="{Binding Count}" />
                                <Label Grid.Row="1" Grid.Column="0" Content="{x:Static lang:ExtraResources.U0254}" />
                                <Label Grid.Row="1" Grid.Column="1" Content="{Binding RunTimes}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static lang:ExtraResources.DeleteText}" IsEnabled="{Binding EnableContextMenu}"
                                  Command="{Binding DeleteSelectedTaskItemCommand}">
                            <MenuItem.Icon>
                                <Label Classes="Icon" Content="&#xE4A6;" FontSize="10" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        <Button Grid.Row="1" Content="{x:Static lang:ExtraResources.U0255}" Command="{Binding ShowAddTaskControlCommand}"/>
    </Grid>
</UserControl>