<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:models="clr-namespace:SRAFrontend.Models;assembly=SRAFrontend"
             xmlns:controls="clr-namespace:SRAFrontend.Desktop.Controls"
             x:Class="SRAFrontend.Desktop.Controls.AnnBoardView"
             x:DataType="controls:AnnBoardViewModel"
             Height="600"
             Width="800">
    <Design.DataContext>
        <controls:AnnBoardViewModel />
    </Design.DataContext>
    <suki:BusyArea BusyText="Loading Announcements..." IsBusy="{Binding IsLoading}">
        <!-- ReSharper disable once Xaml.StyleClassNotFound -->
        <Grid ColumnDefinitions="200,*">
            <ListBox Grid.Column="0"
                     Margin="4"
                     ItemsSource="{Binding Announcements}"
                     SelectedItem="{Binding SelectedAnnouncement}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Announcement">
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1" Margin="8,4" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Classes="h3"
                           Text="{Binding SelectedAnnouncement?.Title}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <controls:ThemedMarkdownScrollViewer Grid.Row="1" Markdown="{Binding Content}" />
            </Grid>
        </Grid>
    </suki:BusyArea>

</UserControl>
