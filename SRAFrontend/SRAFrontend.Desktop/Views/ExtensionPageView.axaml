<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
             xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SRAFrontend.Desktop.Views.ExtensionPageView"
             x:DataType="viewModels:ExtensionPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- 固定卡片区域 -->
            <suki:GlassCard>
                <suki:GroupBox Header="{x:Static lang:Resources.ExtensionText}">
                    <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto" ColumnSpacing="12">
                        <suki:GlassCard Grid.Column="0" Grid.Row="0" Width="200">
                            <suki:GroupBox Header="猫猫糕友人帐">
                                <StackPanel Spacing="4">
                                    <Label Content="查询对应猫猫糕UID"/>
                                    <Button Content="寻找猫猫糕"
                                            Click="Button_OnClick"/>
                                </StackPanel>
                            </suki:GroupBox>
                        </suki:GlassCard>
                    </Grid>
                </suki:GroupBox>
            </suki:GlassCard>

            <!-- 动态扩展区域 -->
            <suki:GlassCard>
                <suki:GroupBox Header="动态扩展">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="从后端加载的扩展列表" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="刷新" Classes="Flat"
                                    Command="{Binding RefreshExtensionsCommand}"/>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingExtensions}"/>
                        <ItemsControl ItemsSource="{Binding Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ExtensionCardViewModel">
                                    <suki:GlassCard Margin="0,4" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Opacity="0.6" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11" Opacity="0.5">
                                                <Run Text="{Binding ExtensionClass}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding ConfigClass}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <ProgressBar IsVisible="{Binding IsRunning}"
                                                             IsIndeterminate="True" Width="40"/>
                                                <Button Content="运行" Classes="Accent"
                                                        Command="{Binding RunCommand}"
                                                        IsVisible="{Binding !IsRunning}"/>
                                                <Button Content="停止"
                                                        Command="{Binding StopCommand}"
                                                        IsVisible="{Binding IsRunning}"/>
                                                <Button Content="配置" Classes="Flat"
                                                        Command="{Binding ConfigureCommand}"
                                                        IsVisible="{Binding HasConfig}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </suki:GroupBox>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
