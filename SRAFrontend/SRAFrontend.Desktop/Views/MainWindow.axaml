<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
        xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
        xmlns:models="clr-namespace:SRAFrontend.Desktop.Models"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        Width="1024" Height="600"
        x:Class="SRAFrontend.Desktop.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/SRAicon.ico"
        Title="StarRailAssistant"
        WindowStartupLocation="CenterScreen"
        FontSize="16">

    <suki:SukiWindow.Hosts>
        <suki:SukiToastHost Manager="{Binding ToastManager}" />
    </suki:SukiWindow.Hosts>
    <suki:SukiWindow.RightWindowTitleBarControls>
        <!-- ReSharper disable Xaml.StyleClassNotFound -->
        <Button Classes="WindowControlsButton" Command="{Binding SwitchLightModeCommand}" ToolTip.Tip="{x:Static lang:Resources.ToggleThemeTooltip}">
            <Label Classes="Icon" Content="{Binding LightModeText}" />
        </Button>
        <Button Classes="WindowControlsButton" Command="{Binding ShowAnnouncementBoardCommand}" ToolTip.Tip="{x:Static lang:Resources.AnnouncementsText}">
            <Label Classes="Icon" Content="&#xE324;" />
        </Button>
        <Button Classes="WindowControlsButton" Command="{Binding ShowActivityCommand}" ToolTip.Tip="{x:Static lang:Resources.EventsText}">
            <Label Classes="Icon" Content="&#xE7B4;" />
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <Grid>
    <suki:SukiSideMenu ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
        <suki:SukiSideMenu.Styles>
            <Style Selector="Image.AppIcon">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0.1" />
                    </Transitions>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Opacity" Value="{DynamicResource ThemeDisabledOpacity}" />
                </Style>
            </Style>
        </suki:SukiSideMenu.Styles>
        
        <suki:SukiSideMenu.ItemTemplate>
            <DataTemplate>
                <suki:SukiSideMenuItem Classes="Compact" Header="{Binding DisplayName}">
                    <suki:SukiSideMenuItem.Icon>
                        <Label Classes="Icon" FontSize="18" Content="{Binding IconText}" />
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </DataTemplate>
        </suki:SukiSideMenu.ItemTemplate>
        
        <suki:SukiSideMenu.HeaderContent>
            <StackPanel>
                <Image Width="80"
                       Height="80"
                       Margin="30,10,30,30"
                       Classes="AppIcon"
                       Source="/Assets/SRAico.png"
                       ToolTip.Tip="{x:Static lang:Resources.JustIconText}" />
                <TextBlock TextWrapping="Wrap" FontSize="16"
                           Text="{Binding GreetingMessage}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </suki:SukiSideMenu.HeaderContent>
        
        <suki:SukiSideMenu.FooterContent>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Command" Value="{Binding OpenUrlCommand}"></Setter>
                    </Style>
                </StackPanel.Styles>
                <Button Classes="Basic"
                        CommandParameter="https://github.com/Shasnow/StarRailAssistant"
                        ToolTip.Tip="{x:Static lang:Resources.GithubToolTipText}">
                    <Label Classes="Icon">&#xE576;</Label>
                </Button>
                <Button Classes="Basic"
                        CommandParameter="https://starrailassistant.top"
                        ToolTip.Tip="{x:Static lang:Resources.WebsiteToolTipText}">
                    <Label Classes="Icon">&#xE976;</Label>
                </Button>
                <Button Classes="Basic"
                        CommandParameter="https://starrailassistant.top/sponsor/"
                        ToolTip.Tip="{x:Static lang:Resources.SponsorText}">
                    <Label Classes="Icon">&#xE2A8;</Label>
                </Button>
                <Button Classes="Basic"
                        CommandParameter="https://starrailassistant.top/getting-started/faq/"
                        ToolTip.Tip="{x:Static lang:Resources.FaqText}">
                    <Label Classes="Icon" Content="&#xE3E8;" />
                </Button>
            </StackPanel>
        </suki:SukiSideMenu.FooterContent>
        <!-- ReSharper restore Xaml.StyleClassNotFound -->
    </suki:SukiSideMenu>

    <!-- 命令面板：Ctrl+Shift+P 打开，点击遮罩关闭；颜色随深浅色模式切换 -->
    <Grid IsVisible="{Binding IsPaletteOpen}"
          Background="{DynamicResource PaletteBackdropBrush}"
          PointerPressed="OnPaletteBackdropPressed">
        <Border Width="640"
                MaxHeight="460"
                VerticalAlignment="Top"
                Margin="0,72,0,0"
                CornerRadius="8"
                BoxShadow="0 16 40 0 #55000000"
                Background="{DynamicResource PalettePanelBrush}"
                BorderBrush="{DynamicResource PaletteBorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBox x:Name="PaletteSearchBox"
                         Margin="12"
                         Height="36"
                         Foreground="{DynamicResource PaletteForegroundBrush}"
                         Background="{DynamicResource PaletteInputBackgroundBrush}"
                         BorderBrush="{DynamicResource PaletteInputBorderBrush}"
                         Text="{Binding PaletteQuery, Mode=TwoWay}"
                         PlaceholderText="{x:Static lang:Resources.CommandPalettePlaceholder}" />
                <TextBlock Grid.Row="1"
                           Margin="16,0,16,10"
                           Foreground="{DynamicResource PaletteSecondaryForegroundBrush}"
                           Text="{x:Static lang:Resources.CommandPaletteNoResults}"
                           IsVisible="{Binding HasNoPaletteResults}" />
                <ListBox Grid.Row="2"
                         Margin="8,0,8,8"
                         MaxHeight="340"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding PaletteResults}"
                         SelectedItem="{Binding PaletteSelected, Mode=TwoWay}"
                         PointerReleased="OnPaletteListPointerReleased">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PaletteCommand">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="14" Foreground="{DynamicResource PaletteForegroundBrush}" Text="{Binding Title}" />
                                    <TextBlock FontSize="14" Foreground="{DynamicResource PaletteSecondaryForegroundBrush}" Text="{Binding Id}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource PaletteSecondaryForegroundBrush}"
                                           Text="{Binding Shortcut}"
                                           IsVisible="{Binding HasShortcut}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
    </Grid>

</suki:SukiWindow>
