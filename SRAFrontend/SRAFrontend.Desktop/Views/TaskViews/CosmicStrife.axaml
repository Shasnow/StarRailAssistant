<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
             xmlns:controls="clr-namespace:SRAFrontend.Desktop.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SRAFrontend.Desktop.Views.TaskViews.CosmicStrife"
             x:DataType="viewModels:TaskPageViewModel">
    <suki:GlassCard>
        <suki:GroupBox>
            <suki:GroupBox.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="{x:Static lang:ExtraResources.U0477}" IsChecked="{Binding CosmicStrifeConfig.IsEnabled}"/>
                    <Button Content="&#xE3D0;" Classes="Flat Icon" Height="20" FontSize="14"
                            Command="{Binding SingleTaskCommand}"
                            CommandParameter="CosmicStrifeTask"
                            ToolTip.Tip="{x:Static lang:ExtraResources.U0478}"/>
                </StackPanel>
                
            </suki:GroupBox.Header>
            <ScrollViewer>
                <StackPanel Margin="10">
                    <suki:GlassCard>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding CosmicStrifeConfig.IsDivergentUniverseEnabled}"
                                      Content="{x:Static lang:ExtraResources.U0479}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Label><x:Static Member="lang:ExtraResources.U0496" /></Label>
                                <ComboBox SelectedIndex="{Binding CosmicStrifeConfig.DivergentUniverseMode}">
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0497" /></ComboBoxItem>
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0498" /></ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Label><x:Static Member="lang:ExtraResources.U0251" /></Label>
                                <NumericUpDown FormatString="0" Value="{Binding CosmicStrifeConfig.DivergentUniverseRuntimes}" Minimum="1" Maximum="99999" />
                            </StackPanel>
                            <ToggleSwitch OnContent="{x:Static lang:ExtraResources.U0480}" IsChecked="{Binding CosmicStrifeConfig.IsDivergentUniverseUseTechnique}" />
                            <ToggleSwitch OnContent="{x:Static lang:ExtraResources.U0481}" IsChecked="{Binding CosmicStrifeConfig.IsPointRewardsEnabled}" />
                        </StackPanel>
                    </suki:GlassCard>
                    <TextBlock><x:Static Member="lang:ExtraResources.U0499" /></TextBlock>
                    <suki:GlassCard>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding CosmicStrifeConfig.IsCurrencyWarsEnabled}"
                                      Content="{x:Static lang:ExtraResources.U0482}" />
                            <Grid ColumnDefinitions="Auto, Auto">
                                <Label Content="{x:Static lang:ExtraResources.U0483}" />
                                <TextBox Grid.Column="1"
                                         Width="320"
                                         Text="{Binding CosmicStrifeConfig.CurrencyWarsUsername}"
                                         PlaceholderText="{x:Static lang:ExtraResources.U0484}"/>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Label><x:Static Member="lang:ExtraResources.U0248" /></Label>
                                <ComboBox SelectedIndex="{Binding CurrencyWarsModeIndex}" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0500" /></ComboBoxItem>
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0501" /></ComboBoxItem>
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0502" /></ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Label><x:Static Member="lang:ExtraResources.U0503" /></Label>
                                <ComboBox SelectedIndex="{Binding CosmicStrifeConfig.CurrencyWarsDifficulty}" Width="200">
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0504" /></ComboBoxItem>
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0505" /></ComboBoxItem>
                                    <ComboBoxItem><x:Static Member="lang:ExtraResources.U0506" /></ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Label><x:Static Member="lang:ExtraResources.U0507" /></Label>
                                <ComboBox ItemsSource="{Binding Cache.Strategies}"
                                          SelectedIndex="{Binding CurrencyWarsStrategyIndex}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title, Converter={x:Static controls:LocalizedStringConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Command="{Binding RefreshStrategiesCommand}"><x:Static Member="lang:ExtraResources.U0431" /></Button>
                                <Button Command="{Binding InstallStrategyCommand}"><x:Static Member="lang:ExtraResources.U0508" /></Button>
                                <HyperlinkButton Content="{x:Static lang:ExtraResources.U0485}" NavigateUri="https://starrailassistant.top/sra-strategy-site/"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Label><x:Static Member="lang:ExtraResources.U0251" /></Label>
                                <NumericUpDown FormatString="0" Value="{Binding CosmicStrifeConfig.CurrencyWarsRuntimes}" Minimum="1" Maximum="99999" />
                            </StackPanel>

                            <ToggleSwitch OnContent="{x:Static lang:ExtraResources.U0486}" IsChecked="{Binding CosmicStrifeConfig.IsCurrencyWarsPointRewardsEnabled}" />

                            <Separator/>

                            <StackPanel IsVisible="{Binding !IsCwNormalMode}" Margin="0,4,0,0" Spacing="4">
                                <TextBlock Foreground="Gray"
                                           Text="{x:Static lang:ExtraResources.U0487}" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Label Content="{x:Static lang:ExtraResources.U0488}" />
                                    <TextBox Width="320"
                                             Text="{Binding CosmicStrifeConfig.CurrencyWarsRerollBossNames}"
                                             PlaceholderText="{x:Static lang:ExtraResources.U0489}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Label Content="{x:Static lang:ExtraResources.U0490}" />
                                    <TextBox Width="320"
                                             Text="{Binding CosmicStrifeConfig.CurrencyWarsRerollBossAffixes}"
                                             PlaceholderText="{x:Static lang:ExtraResources.U0491}" />
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Label Content="{x:Static lang:ExtraResources.U0492}" />
                                    <TextBox Width="320"
                                             Text="{Binding CosmicStrifeConfig.CurrencyWarsRerollInvestEnvironments}"
                                             PlaceholderText="{x:Static lang:ExtraResources.U0493}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Label Content="{x:Static lang:ExtraResources.U0494}" />
                                    <TextBox Width="320"
                                             Text="{Binding CosmicStrifeConfig.CurrencyWarsRerollInvestStrategies}"
                                             PlaceholderText="{x:Static lang:ExtraResources.U0495}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </suki:GlassCard>
                    <TextBlock><x:Static Member="lang:ExtraResources.U0509" /></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </suki:GroupBox>
    </suki:GlassCard>
</UserControl>
