<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:controls="clr-namespace:SRAFrontend.Desktop.Controls"
             xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
             xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SRAFrontend.Desktop.Views.TaskViews.StartGameView"
             x:DataType="viewModels:TaskPageViewModel">
    <suki:GlassCard>
        <suki:GroupBox>
            <suki:GroupBox.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="{x:Static lang:Resources.StartGameLabelText}" IsChecked="{Binding StartGameConfig.IsEnabled}"/>
                    <Button Content="&#xE3D0;" Classes="Flat Icon" Height="20" FontSize="14"
                            Command="{Binding SingleTaskCommand}"
                            CommandParameter="StartGameTask"
                            ToolTip.Tip="{x:Static lang:Resources.SingleRunCountText}"/>
                </StackPanel>
            </suki:GroupBox.Header>
            <ScrollViewer>
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,15" ColumnDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="12">
                        <TextBlock Text="{x:Static lang:Resources.ChannelLabelText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding StartGameConfig.GameChannel}">
                            <ComboBoxItem><x:Static Member="lang:Resources.OfficialServerText" /></ComboBoxItem>
                            <ComboBoxItem><x:Static Member="lang:Resources.BilibiliServerText" /></ComboBoxItem>
                            <ComboBoxItem><x:Static Member="lang:Resources.GlobalServerText" /></ComboBoxItem>
                        </ComboBox>
                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12"
                                    IsVisible="{Binding StartGameConfig.GameChannel, Converter={x:Static controls:GlobalChannelConverter.Instance}}">
                            <TextBlock Text="{x:Static lang:Resources.GlobalServerLabelText}" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding StartGameConfig.GameServer}">
                                <ComboBoxItem>Asia</ComboBoxItem>
                                <ComboBoxItem>Europe</ComboBoxItem>
                                <ComboBoxItem>America</ComboBoxItem>
                                <ComboBoxItem>TW,HK,MO</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <Label Content="{x:Static lang:Resources.GamePathText}"/>
                            <ToggleSwitch OnContent="{x:Static lang:Resources.UseGlobalSettingsText}"
                                          IsChecked="{Binding StartGameConfig.IsUseGlobalGamePath}"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="PathTextBox"
                                 Text="{Binding StartGameConfig.GamePath}"
                                 IsEnabled="{Binding !StartGameConfig.IsUseGlobalGamePath}"/>
                        <Button Grid.Row="1" Grid.Column="1"
                                Classes="Icon"
                                FontFamily="{StaticResource Phosphor}"
                                Content="&#xE256;"
                                Command="{Binding SelectedPathCommand}"
                                IsEnabled="{Binding !StartGameConfig.IsUseGlobalGamePath}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,15"
                                ToolTip.Tip="{x:Static lang:Resources.LaunchWaitTimeDescription}">
                        <Label VerticalAlignment="Center" Content="{x:Static lang:Resources.LaunchWaitTimeText}"/>
                        <NumericUpDown VerticalAlignment="Center" Width="120" Minimum="0" Maximum="120"
                                       FormatString="0" Value="{Binding StartGameConfig.LaunchDelay}"/>
                    </StackPanel>

                    <StackPanel Margin="0,15,0,15">
                        <CheckBox x:Name="AutoLoginCheckBox" Content="{x:Static lang:Resources.AutoLoginText}"
                                  IsChecked="{Binding StartGameConfig.IsAutoLogin}"
                                  ToolTip.Tip="{x:Static lang:Resources.AutoLoginDescription}"/>
                        <TextBlock Margin="25,5,0,0" FontSize="12" Foreground="Gray" TextWrapping="Wrap"><x:Static Member="lang:Resources.AutoLoginAgreementHint" /></TextBlock>
                        <CheckBox Content="{x:Static lang:Resources.AlwaysReloginText}" Margin="0,10,0,0"
                                  IsChecked="{Binding StartGameConfig.IsReLogin}"
                                  ToolTip.Tip="{x:Static lang:Resources.AlwaysReloginDescription}"/>
                    </StackPanel>
                    <Grid RowDefinitions="*, *" ColumnDefinitions="Auto, *, Auto" Width="400" HorizontalAlignment="Left">
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static lang:Resources.AccountLabelText}" />
                        <!-- ReSharper disable Xaml.StyleClassNotFound -->
                        <TextBox Grid.Row="0" Grid.Column="1" suki:TextBoxExtensions.AddDeleteButton="True"
                                 Text="{Binding AccountText}"
                                 GotFocus="OnAccountTextBoxGotFocus"
                                 LostFocus="OnAccountTextBoxLostFocus">
                        </TextBox>
                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static lang:Resources.PasswordLabelText}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="revealPasswordButton" PasswordChar="*" suki:TextBoxExtensions.AddDeleteButton="True"
                                 Text="{Binding StartGameConfig.Password}"/> 
                        <!-- ReSharper restore Xaml.StyleClassNotFound -->
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </suki:GroupBox>
    </suki:GlassCard>
</UserControl>
