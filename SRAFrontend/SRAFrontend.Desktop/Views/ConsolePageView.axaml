<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:lang="clr-namespace:SRAFrontend.Localization;assembly=SRAFrontend"
             xmlns:viewModels="clr-namespace:SRAFrontend.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SRAFrontend.Desktop.Views.ConsolePageView"
             x:DataType="viewModels:ConsolePageViewModel">

    <suki:GlassCard>
        <suki:GroupBox>
            <suki:GroupBox.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Static lang:Resources.ConsoleText}" VerticalAlignment="Center" />
                    <!-- ReSharper disable once Xaml.StyleClassNotFound -->
                    <Button
                        Height="20"
                        Width="20"
                        Classes="Basic Icon"
                        Content="&#xE036;"
                        ToolTip.Tip="重新启动后端"
                        Command="{Binding RestartConsoleCommand}"/>
                    <!-- ReSharper disable once Xaml.StyleClassNotFound -->
                    <Button
                        Height="20"
                        Width="20"
                        Classes="Basic Icon"
                        Content="&#xE3DE;"
                        ToolTip.Tip="停止后端"
                        Command="{Binding StopConsoleCommand}"/>
                    <Button
                        Height="26"
                        Classes="Flat Accent"
                        Padding="8,0"
                        ToolTip.Tip="将控制台、前端、后端日志打包导出为 ZIP 文件"
                        Command="{Binding ExportLogsCommand}"
                        IsEnabled="{Binding !IsExporting}">
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsExporting}">
                                <TextBlock Classes="Icon" Text="&#xEAF0;" VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="导出日志" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="导出中..." IsVisible="{Binding IsExporting}" VerticalAlignment="Center"/>
                        </Panel>
                    </Button>
                    <TextBlock Text="如果要反馈问题，请发送日志文件，而不是这个页面的照片或截图" VerticalAlignment="Center"/>
                </StackPanel>
            </suki:GroupBox.Header>
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="0,4,0,12" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <Label Content="过滤器：" VerticalAlignment="Center" Padding="0" />
                    <!-- ReSharper disable Xaml.StyleClassNotFound -->
                    <ToggleButton Height="20" Padding="14,0" VerticalAlignment="Center" Classes="Discrete" Content="Trace" IsChecked="{Binding FilterOptions[0]}" />
                    <ToggleButton Height="20" Padding="14,0" VerticalAlignment="Center" Classes="Information" Content="Debug" IsChecked="{Binding FilterOptions[1]}" />
                    <ToggleButton Height="20" Padding="14,0" VerticalAlignment="Center" Classes="Success" Content="Info" IsChecked="{Binding FilterOptions[2]}"/>
                    <ToggleButton Height="20" Padding="14,0" VerticalAlignment="Center" Classes="Warning" Content="Warn" IsChecked="{Binding FilterOptions[3]}"/>
                    <ToggleButton Height="20" Padding="14,0" VerticalAlignment="Center" Classes="Danger" Content="Error" IsChecked="{Binding FilterOptions[4]}"/>
                    <!-- ReSharper restore Xaml.StyleClassNotFound -->
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Background="#0B0B0E"
                    BorderBrush="#1F1F23"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                    <ScrollViewer x:Name="ConsoleScrollViewer">
                        <SelectableTextBlock
                            x:Name="ConsoleText"
                            Margin="10,6"
                            FontFamily="Cascadia Mono,Consolas"
                            FontSize="13"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <TextBox Grid.Row="2" Margin="0,12,0,0" PlaceholderText="请输入文本" KeyDown="InputElement_OnKeyDown"/>
            </Grid>
        </suki:GroupBox>
    </suki:GlassCard>
</UserControl>
