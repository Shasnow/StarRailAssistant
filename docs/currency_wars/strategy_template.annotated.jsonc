// 货币战争配置填写指导
//
// 这是一份完整的银狼阵容示例，用来演示格式；角色和数值不是所有阵容的通用推荐。
// 同目录 strategy_template.json 是内容相同、去掉注释的可加载版本。
// 本文件使用 JSONC 的 // 注释。程序使用严格 JSON 读取，不能直接加载本文件，
// 也不能只改扩展名。建议参照本文件，修改 strategy_template.json 的副本。
//
// 填写顺序：
// 1. 改 title/description/author；不使用游戏内攻略码就保留 share_code 为 ""。
// 2. 改根级 on_field/off_field 的角色和目标星级，再改 main_c。
// 3. 改 formation 的过渡阵容、职责、候选席位和保护规则；更换角色要同步所有引用。
// 4. 改 economy 的升级节奏、金币保留，以及 equipment 的分配规则。
// 5. 另存为自己的英文文件名，例如 my_strategy.json，使用 UTF-8 编码（无 BOM）。
// 6. 将配置放入 tasks/currency_wars/strategies/。
//    重新打开助手/刷新攻略列表后，在货币战争设置中选择该攻略，再启动任务。
//
// 基本规则：
// - 所有键名和字符串使用英文双引号；true/false/null 小写；最后一项后不加逗号。
// - 数字不要加引号。未列出的自创字段不会自动变成新功能，部分字段会直接报错。
// - 角色名以 tasks/currency_wars/characters.py 的定义为准，优先使用规范名称。
//   “银狼LV.999”和“银狼”、“火花”和“花火”是不同角色，不能互换。
// - 星级含义要分清：根级数值=采购目标；席位候选 min_stars 和阶段 requires_stars
//   是准入条件，不会自动提高采购目标；职责 min_stars 则会在职责有缺口时，
//   驱动达到所需星级的采购，并与根级目标合并取较高值。
// - 本目录是资料目录，不会把这份示例自动加入运行攻略或替换正在使用的配置。
{
  // 展示信息。为兼容现有攻略列表，保留 title、author、description 和旧经济字段。
  "title": "【填写模板】新版货币战争配置（银狼示例）",
  "description": "用于填写新攻略的完整示例；请根据阵容调整角色、经济阶段与装备规则。",
  "author": "",
  "uploader": "",
  // 游戏内攻略分享码，不是 JSON 文件名。空字符串表示不自动导入游戏内攻略码。
  // 填写真实分享码时，应与自己的阵容相符；本地采购和布阵仍按下面的字段执行。
  "share_code": "",

  // 首次主 C 上阵规则。main_c 可填角色名，或 null 关闭；不要填空字符串。
  // 主 C 必须出现在根级 on_field/off_field 中；搜索等级必须是正整数，默认 5。
  // 日常运营达到此等级后，先搜到并确认主 C 合法上阵，再继续升级。
  // 备战席持有不算首次上阵；首次确认不要求先升到采购目标星级。
  // 注意：本模板后面的 all_in_round 冲级规则触发后会覆盖这项日常升级限制。
  "main_c": "银狼LV.999",
  "main_c_search_level": 5,
  // 首次搜主 C 的储备，非负整数，默认 0。
  // 开启 economy 时作为该阶段保留金币 R；刷新/买经验另留 purchase_reserve_gold。
  "main_c_search_min_coins": 0,

  // 旧经济参数：保留用于兼容展示和关闭 economy 后的运营。
  // economy.enabled=true 时，下列三项不参与新经济决策。
  // min_coins 是旧普通刷新入口门槛，并非一切支出后的余额底线。
  // min_level 是旧补级目标，mid_level 是旧条件式升级上限；均为非负整数。
  "min_coins": 20,
  "min_level": 5,
  "mid_level": 7,

  // 整备预算。可整块删除以使用下列默认值，通常不需要调整。
  // 正整数最多 600；recoveries、move_retries 允许 0。
  "preparation_budget": {
    // 本准备期布阵共用时限，不能大于 total_seconds。
    "seconds": 120,
    // 移动尝试次数上限，不是买牌次数。
    "actions": 20,
    "recoveries": 2,
    // 同一移动允许的额外重试次数。
    "move_retries": 1,
    // 准备流程共用时限；购物耗时会加回预算，不是绝对墙钟总时长。
    "total_seconds": 300,
    // 场地证据过期后需要刷新，单位秒；不是装备检查间隔。
    "field_refresh_seconds": 60
  },
  // 商店预算。可整块删除以使用下列默认值。
  // actions/seconds 为 1–300 的整数，其余为 0–300；日常运营中0禁用对应支出动作。
  // 例外：all_in_round 生效时会按金币提高 actions/purchases/refreshes/experiences
  // 的执行额度，包括原来设为0的项；300仅是这里的填写上限，不是该分支的固定上限。
  // 在非3-7回合，要让0禁用对应操作，需同时删除 economy.all_in_round。
  // 可靠确认3-7时强制执行终局运营，仍会覆盖上述日常预算与保留金币。
  // 当前同一准备期的多次购物交接共用已消耗次数，不会每开一次商店就重置。
  "shopping_budget": {
    // 购买、刷新、买经验合计的输入尝试上限。
    "actions": 60,
    // 历史兼容字段：当前正常购物不按此值限制总秒数，调大它不会延长购物。
    "seconds": 90,
    "purchases": 60,
    "refreshes": 60,
    "experiences": 60
  },

  // 根级名单：对象，格式为“角色名”: 目标星级，直接填 1、2、3。
  // 开启 formation 后，不要使用旧式 4/9 张数量写法。
  // 根级名单涵盖整套攻略的正式与过渡采购目标，不等于只买当前阶段的角色。
  // 顺序会用于基础优先级；具体阶段部署顺序由 formation.stages[].priority 决定。
  // 过渡角色可放在根级 off_field，却在部分阶段前台使用，最终看阶段有效目标。
  // 未知角色在根加载器中可能被跳过，不能用“没有报错”判断拼写正确。
  "on_field": {
    "银狼LV.999": 2,
    "火花": 2,
    "银狼": 2,
    "缇宝": 2
  },
  "off_field": {
    "爻光": 2,
    "绯英": 2,
    "花火": 2,
    "开拓者": 2,
    "符玄": 2,
    "千冶·刃": 2
  },

  // 已支持特殊事件的选项关键词，不是新增事件处理器的定义。
  // 键和值都必须是字符串；无需定制时可填 {}。
  // 当前支持此关键词配置的事件：头号玩家、盛会之星、命运卜者、领航员、命运圣杯。
  // 值填写目标选项中可识别的文字；示例沿用当前攻略的事件选择。
  // 多个关键词用空格分隔，匹配任一即可；按界面选项顺序取首个匹配，
  // 关键词的书写顺序不是优先级。非空关键词一个都匹配不到时停止该次选择。
  "special_events": {
    "头号玩家": "银狼",
    "盛会之星": "花火"
  },

  // 分阶段阵容。省略整个 formation 或设 null，才会沿用旧布阵流程。
  // 写了对象后必须有非空 stages；其余模块按需保留，角色引用须一致。
  "formation": {
    // 可替换席位组。secondary_dps 是自定义组名，供 requires_assignment 引用。
    // 不需要副 C 择优时可删除 assignment_groups；也要删除引用该组的条件。
    "assignment_groups": {
      "secondary_dps": {
        // 该组管理前台的一个席位。目前 count 只能是 1，不能填 2。
        "area": "on_field",
        "count": 1,
        // 候选必须同时在根级采购名单里，同一角色不能跨多个席位组重复。
        // 先比可靠星级，再比 rank（整数 0–100000，越大越优先）。
        // 因此两星高 rank 火花不能凭 rank 换掉三星绯英。
        "candidates": [
          {"name": "火花", "rank": 200, "min_stars": 2},
          {"name": "绯英", "rank": 100, "min_stars": 1}
        ],
        // 只能列本组候选。各阶段的目标区域最多包含其中一名；至少一阶段要有席位。
        "replace_from": ["绯英", "火花"],
        // 以下三个字段目前只支持所示值，不是可任意切换的策略选项。
        "star_policy": "prefer_not_lower",
        "keep_incumbent_on_tie": true,
        "on_unavailable": "keep_current"
      }
    },
    // 站位迁移，只作用于已经属于当前阶段目标的角色，不会新增采购目标。
    // 同角色只能写一条，必须在根采购名单中，不能同时是上述席位组候选。
    "position_rules": [
      {
        "name": "爻光",
        "area": "off_field",
        // 0–10 的整数，按普通角色名额判断：游戏人口总上限减去已确认占人口的NPC数。
        // 本例普通角色名额达到七人口起独立转后台，不依赖是否选中火花。
        "min_capacity": 7
        // 如需“选中火花后才迁移”，在 min_capacity 行末加逗号，再加入：
        // "requires_assignment": {"secondary_dps": "火花"}
        // 多组条件必须全部满足；省略或 {} 表示不依赖席位选择。
      }
    ],
    // 职责提供者定义。survival 是自定义职责名；还需 role_requirements 才会提出需求。
    // area 可为 "on_field"、"off_field" 或二者数组，省略表示两边都允许。
    // min_stars 为 1–3 的整数，默认 1；角色需在指定区域达标才算提供职责。
    // 不在场、只在备战席或星级未知，都不算已满足。
    // 这是沿用现攻略的角色示例；更换角色时，要自己核对其真实生效区域与条件。
    // source 即使填写，也只是一条资料注记，程序不会读取或验证它。
    "roles": {
      "survival": [
        {"name": "符玄", "area": "off_field", "min_stars": 1},
        {"name": "藿藿", "area": ["on_field", "off_field"], "min_stars": 1},
        {"name": "风堇", "area": "on_field", "min_stars": 1}
      ]
    },
    "role_requirements": {
      "survival": {
        // 至少几名不同角色满足职责，整数 1–10；不能超过候选数量和可用区域容量。
        "minimum": 1,
        // 正式候选；必须来自同一职责的 roles 定义。
        "candidates": ["符玄"],
        // 过渡候选，不能与正式候选重复；可不在根采购名单，由职责缺口驱动采购。
        // 已有足够职责覆盖时，不会为了这个职责继续购买所有备选。
        "interim_candidates": ["藿藿", "风堇"],
        // warn_continue：缺牌或确认没有合法部署方案时，可记缺口并继续。
        // 但仍有关键待部署角色、未确认移动等问题时，不会直接放行。
        // block：职责未满足就阻止出战。只有这两个值可用。
        "on_missing": "warn_continue"
      }
    },
    // 手工声明羁绊成员。仅统计可靠上场的不同角色，同名副本不会重复计数。
    // 不会自动查询游戏数据，也不会按角色费用推断有几名羁绊成员。
    "traits": {
      "银狼LV.999": ["欢愉", "星核猎手"],
      "爻光": ["欢愉"],
      "绯英": ["欢愉"],
      "开拓者": ["欢愉"],
      "火花": ["欢愉"],
      "千冶·刃": ["星核猎手"],
      "银狼": ["星核猎手"]
    },
    // 只保护已经达到的阈值，避免换人后跌破；不会主动要求凑出该羁绊。
    // 键必须在 traits 的成员声明中出现，值为正整数。
    "preserve_traits": {"欢愉": 3, "星核猎手": 2},
    // “受保护角色”: “接班角色”。接班者已可靠上场后才解除保护。
    // 不能自指或循环依赖；不能假定一次尚未执行的一换一会提前解除保护。
    "protect_until_fielded": {"千冶·刃": "银狼"},

    // 常规升级额外条件。不需要就用 null 或删除；不决定目标等级。
    // 启用示例：把 null 替换为下面对象（这里只演示结构，不预设最优门槛）：
    // {"from_level": 7, "fielded": {"银狼LV.999": 2},
    //  "traits": {"欢愉": 3}, "prices": {"银狼LV.999": 4}}
    // 含义：当前等级 >= 7 时，要求主 C 已上场且至少两星、在场欢愉至少三名、
    // 主 C 的可靠观测费用至少四费；三类要求同时满足才放行常规买经验。
    // prices 不是购买价格上限。fielded/traits/prices 可省略，from_level 必填。
    // 当前 all_in_round 的最终冲级分支会覆盖此升级条件，详见下方说明。
    "upgrade_gate": null,

    // 阵容阶段按顺序判断：遇到第一个不满足的阶段就停止，不跳过它选后面的阶段。
    // min_capacity 是普通阵容角色的人口容量门槛，不是战斗场数，也不会自动买经验升级。
    // 判断值 = 游戏人口总上限 - 已确认上场并占人口的NPC数量；不是当前已上场的普通角色数。
    // 例如总上限6、NPC1个，按5人口阶段；总上限10、NPC1个，才能按9人口阶段。
    // 部署防超员仍按游戏总上限，NPC不能移动/替换。未知、备战席、不可用锁定格不参与NPC扣减。
    // 曾认证的NPC暂时转为未知时继续保留占位，待前后台全部可靠、证实其消失后才释放。
    // 首阶段必须 min_capacity=0，且不能加任何角色前置条件。
    // 后续 min_capacity 不得下降，可相同；各阶段 name 必须非空且不重复。
    // 本块 on_field/off_field 是角色名数组，与根级的“角色:星级”对象不同。
    // 前台须 1–4 人，按实际布局安排后台（程序物理上最多六槽）；两区不能同名。
    // 阶段名单和三类角色前置条件中的角色，必须来自根采购名单或 roles 提供者；
    // priority 只能列本阶段前后台名单里的角色。
    // 优先级用于人口不足时选择先上谁，不是固定格子坐标。
    // priority 可省略/只列一部分，未列者按前台、后台名单补齐。
    "stages": [
      {
        "name": "前期主C与猎手过渡",
        "min_capacity": 0,
        "on_field": ["银狼LV.999", "爻光", "绯英", "缇宝"],
        "off_field": ["千冶·刃"],
        "priority": ["银狼LV.999", "爻光", "千冶·刃", "绯英", "缇宝"]
      },
      {
        "name": "六人口优先补生存",
        "min_capacity": 6,
        "on_field": ["银狼LV.999", "爻光", "绯英", "缇宝"],
        "off_field": ["千冶·刃", "符玄"],
        "priority": ["银狼LV.999", "符玄", "爻光", "千冶·刃", "绯英", "缇宝"]
      },
      {
        "name": "七人口补齐后台",
        "min_capacity": 7,
        "on_field": ["银狼LV.999", "爻光", "绯英", "缇宝"],
        "off_field": ["千冶·刃", "符玄", "花火"],
        "priority": ["银狼LV.999", "符玄", "爻光", "千冶·刃", "绯英", "缇宝", "花火"]
      },
      {
        "name": "八人口保生存待最终角色",
        "min_capacity": 8,
        "on_field": ["银狼LV.999", "爻光", "绯英", "缇宝"],
        "off_field": ["千冶·刃", "符玄", "花火", "开拓者"],
        "priority": ["银狼LV.999", "符玄", "爻光", "千冶·刃", "绯英", "缇宝", "花火", "开拓者"]
      },
      {
        "name": "最终四前台五后台",
        "min_capacity": 9,
        // 可靠持有即可，备战席也算；不是要求已经上场。
        "requires_available": ["银狼", "火花"],
        // 进入此阶段还需可靠持有至少两星火花；根级采购目标应至少达到该星级。
        "requires_stars": {"火花": 2},
        // 可选 requires_fielded: ["银狼LV.999"] 要求已在前台或后台。
        // 新阶段才计划上场的角色宜用 requires_available，避免循环依赖。
        // 可选 role_requirements: {"survival": {"on_missing": "block"}}
        // 表示本阶段覆盖全局职责的缺口策略；其他子字段继承全局，不继承前一阶段。
        "on_field": ["银狼LV.999", "火花", "银狼", "缇宝"],
        "off_field": ["爻光", "绯英", "花火", "开拓者", "符玄"],
        "priority": ["银狼LV.999", "银狼", "爻光", "绯英", "火花", "缇宝", "花火", "开拓者", "符玄"]
      }
    ]
  },

  // 可选开局保护。省略/null 不增加回合限制；只配置一个字段时只限制该动作。
  // 必须使用 x-y 格式；1-4 表示1-1至1-3禁用，从1-4含本回合开始允许。
  // 回合未确认时继续禁用；不会用脚本循环数、战斗数或上一局的回合推断。
  // 禁刷新期间仍采购自然商店中的攻略/职责目标；经验执行原经济及升级门槛。
  // 禁卖期间保留全部起手牌；开放后仍需可靠场上/人口证据才能清理过渡牌。
  "opening_policy": {
    "sell_from_round": "1-4",
    "refresh_from_round": "1-4"
  },

  // 新经济规则。省略/null 或 enabled=false 使用旧 min_coins/min_level/mid_level。
  // enabled 省略也视为 false。不要混入旧草案 roll_from_level/overflow_gold 等字段。
  "economy": {
    "enabled": true,
    // R 是当前阶段 reserve_gold；P 是下面的 purchase_reserve_gold。
    // P：刷新或买经验后额外为买牌预留的钱，非负整数，省略默认 0。
    // 日常买需求卡：花费后余额 >= R；刷新/买经验：花费后余额 >= R+P。
    // 例如 R=20、P=5，买卡可花到剩20；刷新/买经验最多花到剩25。
    // 有效 R=0 时按需求连续采购，漏读价格也可尝试；同页允许适度超买。
    // 页末只读实际金币，满足刷新条件则保留购买记录继续搜牌。
    // 到金币线、空间/预算边界或需解锁上阵/升级时，统一核实持有/星级，再布阵卖余牌。
    // 未变化角色复用上次记录；合成涉及角色和新占格重读，异常则回退完整扫描。
    // 未成交槽位本页只尝试一次；R>0 仍须确认价格以保护保留金。
    // 首次搜主 C 时 R 改用 main_c_search_min_coins；all_in 生效时 R/P 都改为0。
    "purchase_reserve_gold": 5,
    // 非空数组；与 formation.stages 相互独立。
    // from_battles=已确认结束的真实战斗数，不是脚本循环次数、也不是“3-7”关卡。
    // 第一行必须从0开始，后续严格递增；target_level 不得下降，可以相同。
    // from_battles/reserve_gold/upgrade_gold 为非负整数（upgrade_gold 也可 null）。
    // target_level 解析范围1–20，但须填玩法实际可达到的目标，本例最终9级。
    // 配了 main_c 时，最后一行的目标等级不得低于 main_c_search_level。
    "stages": [
      {
        "from_battles": 0,
        "target_level": 5,
        "reserve_gold": 0,
        // null 或省略：本行不使用金币提前触发。
        "upgrade_gold": null
      },
      {
        // 满足“完成6战”或“确认金币达到60”任一条件，即可进入这一行。
        "from_battles": 6,
        "target_level": 7,
        "reserve_gold": 20,
        // 这是提前进入“本行”的金币门槛，不是进入下一行的门槛，
        // 也不是每次按经验都要保留60金币。金币触发需要两次稳定读数。
        "upgrade_gold": 60
      },
      {
        "from_battles": 12,
        "target_level": 9,
        "reserve_gold": 20,
        "upgrade_gold": 100
      }
    ],
    // 经济阶段选符合条件的最高一项，同局不会因为花钱而倒退。
    // 关卡冲级规则（可选）：不需要就删除 all_in_round 整行，不要设 null/false。
    // 必须是形如 "3-7" 的字符串，两段各为1–9，不能写 "3-10" 或战斗次数。
    // 到达该准备关卡及以后，若等级/经验/金币可靠，且足够一次完成剩余升级，
    // 则优先买经验到 stages 最后一行的目标等级；每次支出后重新确认。
    // 当前执行代码在这一冲级分支中会覆盖首次主 C 搜索和 upgrade_gate 限制，
    // 并优先于普通需求牌采购。非3-7回合若希望先主 C/先满足门槛，请删除本字段。
    // 达到最终等级后，取消 R/P 保留，用于需求牌与刷新；不代表无目标也必花完。
    // 关卡、费用无法确认或钱不够完整升级时，沿用日常阶段运营。
    // 支出次数会按金币扩大额度（见 shopping_budget），停止检查与场地/交易确认
    // 仍有约束，不保证一轮就完成升级。
    // 独立规则：3-7可靠备战对所有攻略强制终局运营，删除本字段或禁用economy
    // 都不能关闭它。该规则覆盖主C、upgrade_gate、目标等级、保留金币和日常预算；
    // 足够完整升一级就升，再重新判断；不能完整升级或确认满级则采购需求牌和搜牌。
    // 付费与免费搜牌输入合计最多80次，同一备战内部恢复不重置，最后一次页面仍采购。
    // 达到上限，或只剩1金币且无可买1费需求牌时可能留金币；证据未知时进入恢复。
    "all_in_round": "3-7"
  },

  // 新装备规则。整块删除/null 可关闭角色与关卡筛选，保留旧装备行为。
  // priority_characters 和 others_from_round 必填，interval_battles 可省略（默认2）。
  // 不要同时再填顶层 equipment_interval_battles；旧字段仍兼容，
  // 但两处间隔不同会报错。只要节流、不需角色/关卡筛选，可仅使用旧顶层字段。
  "equipment": {
    // 非空、无重复的合法角色列表；顺序就是已上场合格角色的装备检查优先顺序。
    // 不能使用 NPC/不可操作角色。不会自动购买或部署这里的角色。
    "priority_characters": ["银狼LV.999"],
    // 此准备关卡前只为优先名单内的已上场角色处理装备；达到后才开放其他角色。
    // 关卡未知仍只允许优先角色。格式同 all_in_round，不是累计战斗数。
    "others_from_round": "3-4",
    // 正整数：每确认完成几场战斗后检查一批装备，2表示通常第2/4场后到期。
    // 仅按间隔计数时不在首战前额外跑一批；资源变化本身不会绕过间隔。
    // 当前实现还会在首次可靠达到 others_from_round 时安排其他角色开放后的检查。
    // 因此若把开放关卡改成 "1-1"，首战前也可能因开放条件触发装备检查。
    // 优先顺序不保证一定穿戴成功，实际取决于已上场角色、可用装备及界面确认。
    "interval_battles": 2
  }
}

// 可选低频字段与兼容提醒：
// - 顶层 health_roi: [0.1, 0.1, 0.2, 0.2] 是血量OCR矩形的结构示例，
//   四个数依次是归一化 x1/y1/x2/y2（0–1），需 x1<x2 且 y1<y2。
//   这里的坐标不是已校准值，请勿照抄；无自己校准的区域时省略此字段。
// - preparation_budget.confirmation_seconds 当前仅有解析校验，尚未接入执行，
//   不要靠填写它调整动作确认超时。
// - 若删除 roles 中某个职责，要同时删除全局和各阶段对它的 role_requirements。
// - 若删除 traits，要同时清理 preserve_traits 和 upgrade_gate.traits。
// - 更换阵容时，除了采购名单，还要核对 main_c、职责、席位候选、迁移、
//   羁绊成员、接班保护、阶段前置条件、特殊事件、装备优先名单中的全部角色引用。
// - 旧说明里“装备只能用 equipment_interval_battles”以及“8/9级必须手动”
//   不适用于此模板；本模板使用 equipment 对象和最终9级的 economy 阶段表。
// - 这份模板是合法格式示例。字段能解析不等于所填阵容和数值已通过实机调优。
//
// 核对依据（项目相对路径）：
// tasks/currency_wars/CurrencyWars.py：load_strategy、_economy_context、shopping。
// tasks/currency_wars/formation.py：validate_formation_config 和阶段/席位/职责执行逻辑。
// tasks/currency_wars/economy.py、equipment_policy.py、preparation.py：参数校验与规则。
